{
  "expo": {
    "name": "ClearPath",
    "slug": "eyesight-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "clearpath",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yuyi.clearpath",
      "infoPlist": {
        "NSCameraUsageDescription": "ClearPath needs camera access to measure your distance and detect which eye is being tested."
      }
    },
    "android": {
      "package": "com.yuyi.clearpath",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "ClearPath needs camera access to measure distance and detect which eye is being tested.",
          "enableMicrophonePermission": false,
          "enableLocation": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "692a1e4b-e0cb-4036-a853-88aafb5a43b4"
      }
    }
  }
}